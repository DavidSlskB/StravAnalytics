echo "STRAVA_CLIENT_ID=your_client_id" > .env.example
echo "STRAVA_CLIENT_SECRET=your_client_secret" >> .env.example
echo "STRAVA_ACCESS_TOKEN=your_access_token" >> .env.example
echo "STRAVA_REFRESH_TOKEN=your_refresh_token" >> .env.example
echo "STRAVA_TOKEN_EXPIRES_AT=your_expires_at" >> .env.example